        <mxCell id="c34" value="RAIZ" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#C00000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="554.125" y="66" width="70" height="20" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Naranja = RAIZ (A, sin padre)&lt;br&gt;Azul = nodo INTERNO (tiene hijos)&lt;br&gt;Verde = HOJA (sin hijos)&lt;br&gt;&lt;br&gt;g = grado (numero de hijos)&lt;br&gt;p = profundidad (aristas desde la raiz)&lt;br&gt;h = altura del nodo&lt;br&gt;&lt;br&gt;Recuadro gris punteado = hermanos H, I, J (hijos de D)&lt;br&gt;Recuadro morado punteado = subarbol de B (B, E, K, L, F)&lt;br&gt;&lt;br&gt;&lt;b&gt;Resumen&lt;/b&gt;&lt;br&gt;Grado del arbol = 3&lt;br&gt;Altura del arbol = 3&lt;br&gt;Hojas = 7 | Internos = 6" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F2F2F2;strokeColor=#2E75B6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="290" height="400" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
