        <mxCell id="c42" value="Se busca el sucesor inorden (minimo del subarbol derecho = 60), se copia en el nodo y se elimina el 60 original (su hijo 65 sube)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1240" height="24" as="geometry"/></mxCell>
