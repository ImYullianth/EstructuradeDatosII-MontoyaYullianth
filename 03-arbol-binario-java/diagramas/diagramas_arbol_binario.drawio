        <mxCell id="c18" value="Amarillo = nodo interno (al menos un hijo)  |  Verde = nodo hoja (objeto real con sus dos referencias en null)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="980" height="24" as="geometry"/></mxCell>
